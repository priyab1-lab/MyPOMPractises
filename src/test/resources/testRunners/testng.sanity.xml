<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Open Cart Test Regression Suite" verbose="3" parallel="tests" thread-count="3">
	
	<test name="Login Page Test">
		<parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.opencart.qa.test.LoginPageTest" />
        </classes>
   </test>
   
   <test name="Home Page Test">
	   <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.opencart.qa.test.HomePageTest" />
        </classes>
   </test>
   
   <test name="ProductInfo Page Test">
	   <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.opencart.qa.test.ProductInfoPageTest" />
        </classes>
   </test>
   
   
</suite>